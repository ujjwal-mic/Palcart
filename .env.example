# =====================================================================
#  PalCart settings
#  1. Copy this file to a new file named  .env
#  2. Fill in the 5 keys in section 1 (that is all you need to start)
#  3. Leave section 2 alone unless you know you need to change something
# =====================================================================


# ---------------------------------------------------------------------
#  SECTION 1: THE 5 KEYS YOU MUST FILL IN
#  (paste the key right after the "=", with no quotes and no spaces)
# ---------------------------------------------------------------------

# Product search (Channel3)
CHANNEL3_API_KEY=your-channel3-key

# PayPal sandbox payments (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Cloud browser robot (KERNEL) (dashboard.onkernel.com)
KERNEL_API_KEY=your-kernel-key

# AI brain (Google Gemini) (free key at aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key



# =====================================================================
#  SECTION 2: OPTIONAL SETTINGS. The defaults below already work.
# =====================================================================

# ---------- AI model ----------
# gemini = Google Gemini (cloud).  omlx = a local model on your own computer.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini/gemini-1.5-flash
# Only used when LLM_PROVIDER=omlx (a local server, so it can't be used when hosted)
OMLX_BASE_URL=http://localhost:8080/v1
OMLX_MODEL=your-local-model-name
OMLX_API_KEY=omlx-local

# ---------- PayPal ----------
# sandbox = test money.  live = REAL money (use sandbox!).
PAYPAL_MODE=sandbox
# Only needed if you want PayPal webhooks (the demo also works without them)
PAYPAL_WEBHOOK_ID=
# Testing only: skip the webhook signature check. Never true in real use.
PAYPAL_SKIP_WEBHOOK_VERIFY=false
# Advanced: paste a ready-made access token instead of using the client id/secret above
# PAYPAL_ACCESS_TOKEN=
# Advanced: custom command to start the PayPal MCP server (the Docker image sets this for you)
# PAYPAL_MCP_COMMAND=

# ---------- Cloud browser robot (KERNEL) ----------
# true = the robot fills in the checkout but does NOT press the final pay button.
KERNEL_DRY_RUN=true
# false = you get a "WATCH LIVE" link in the terminal to watch the robot work.
KERNEL_HEADLESS=false
KERNEL_TIMEOUT_SECONDS=300
# true = record every order, so you can replay it later at  /api/orders/<ORDER ID>/replay
# (the live view link is always printed in the terminal)
ORDER_VIDEO=false

# Delivery details the robot types into the shop's checkout form
SHIP_NAME=
SHIP_EMAIL=
SHIP_ADDRESS=
SHIP_CITY=
SHIP_ZIP=
# Card the robot uses at the shop. Use a single-use / limited virtual card, never your own.
VIRTUAL_CARD_NUMBER=
VIRTUAL_CARD_EXP=MM/YY
VIRTUAL_CARD_CVV=

# ---------- Shop choice ----------
# Shops where guest checkout works (comma separated). They are shown first,
# on top of the built-in list in backend/guest_checkout_sites.py
EXTRA_GUEST_CHECKOUT_SITES=
# false (recommended) = ONLY buy from the trusted shops. true = also allow unknown shops (risky:
# some look real but have broken checkouts or are not real stores).
ALLOW_UNKNOWN_SHOPS=false

# ---------- App ----------
# Spending limit per order, in USD (enforced in code)
MAX_ORDER_USD=50
# Where PayPal can reach this server, and where the dashboard lives.
# (Docker sets both for you. Change them only if you host the app online.)
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
